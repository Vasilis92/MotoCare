{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MotoCare",
  "version": "0.1.0",
  "identifier": "com.motocare.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MotoCare Desktop",
        "width": 1080,
        "height": 740,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
